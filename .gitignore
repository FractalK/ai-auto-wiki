.DS_Store
.gitignore
node_modules
public/
prof
tsconfig.tsbuildinfo
.obsidian
.quartz-cache
private/
.replit
replit.nix

# Exclude Obsidian's default save location to reduce friction and mistakes
Clippings/

# Wiki: exclude source files — potentially large or copyright-restricted
raw/staged/
raw/processed/

# Wiki: session-generated decision forms (template is committed; session output is not)
ingest-decisions.html
lint-decisions.html

# Wiki: lint script output — ephemeral, deleted after Phase 3 completes
lint-findings.json

# Wiki: structured-data extraction artifacts — regenerated in full on every
# lint run, never hand-edited, not deleted by Phase 3 (BL-W-02, DM-128)
raw/claims.json
raw/data-records.json

# Keep .gitkeep files in tracked empty directories
!**/.gitkeep
wiki-dashboard.html
